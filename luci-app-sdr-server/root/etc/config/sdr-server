config main 'main'
	option enabled '1'
	option bind_address '0.0.0.0'
	option port '8090'
	option buffer_size '262144'
	option queue_size '64'
	option read_timeout_seconds '5'
	option lpf_cutoff_rate '5'
	option sdr_type '0'
	option cpu_optimization 'NATIVE_CF32'
	option band_sampling_rate '2016000'
	option use_gzip '1'
	option base_path '/tmp/sdr-server'

	option gain_mode '1'
	option gain '49.0'
	option ppm '0'
	option device_index '0'
	option bias_t '0'

	option airspy_gain_mode '0'
	option airspy_vga_gain '5'
	option airspy_mixer_gain '5'
	option airspy_lna_gain '5'
	option airspy_linearity_gain '0'
	option airspy_sensitivity_gain '0'

	option hackrf_amp '0'
	option hackrf_lna_gain '16'
	option hackrf_vga_gain '20'
	option hackrf_bias_t '0'
