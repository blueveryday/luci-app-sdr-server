#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/sdr_server
RENDER=/usr/libexec/sdr-server-render-config
CONFIG_FILE=/etc/sdr-server/config.conf

start_service() {
	[ -n "${IPKG_INSTROOT:-}" ] && return 0
	local enabled
	config_load sdr-server
	config_get enabled main enabled 1
	[ "$enabled" = "1" ] || {
		logger -t sdr-server "disabled in UCI configuration"
		return 0
	}

	[ -x "$PROG" ] || {
		logger -t sdr-server "missing executable: $PROG"
		return 1
	}

	"$RENDER" || {
		logger -t sdr-server "failed to render $CONFIG_FILE"
		return 1
	}

	procd_open_instance
	procd_set_param command "$PROG" "$CONFIG_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "sdr-server"
}

reload_service() {
	stop
	start
}